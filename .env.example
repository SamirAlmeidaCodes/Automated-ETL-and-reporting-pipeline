# Copy this file to .env. The scheduler loads it on startup.
# docker compose reads UID, GID, and ETL_ENV when it starts the container.
# Values already exported in your shell take priority.
# Never commit .env. Every value below is a placeholder, not a real credential.

ETL_ENV=production

UID=1000
GID=1000

# Used when email.enabled is true in config.yaml.
# Replace these with your own SMTP settings in .env only.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace-with-a-real-password
SMTP_FROM=weather-etl@example.com
SMTP_TO=ops@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
