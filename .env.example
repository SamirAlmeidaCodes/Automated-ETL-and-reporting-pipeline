# Copy this file to .env. The scheduler loads it on startup.
# docker compose reads UID and GID when it sets the container user.
# Values already exported in your shell take priority.

UID=1000
GID=1000

# Used when email.enabled is true in config.yaml.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
